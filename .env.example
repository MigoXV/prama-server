# HTTP 服务监听配置
PRAMA_SERVER_HTTP_HOST=0.0.0.0
PRAMA_SERVER_HTTP_PORT=8000
PRAMA_SERVER_HTTP_RELOAD=false

# 评估数据与文件上传根目录；未设置时默认使用 ./data-bin
PRAMA_WORKDIR=./data-bin
# PRAMA_UPLOAD_ROOT=./data-bin

# 已构建前端产物目录；未设置时默认使用 src/web/dist
# PRAMA_SERVER_WEB_DIST=./src/web/dist

# Vite 开发服务器的 /api 代理目标；仅在 pnpm --dir src/web dev 时使用
VITE_API_PROXY_TARGET=http://localhost:8000
